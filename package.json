{
  "name": "pokerogue-regions",
  "private": true,
  "version": "1.0.0-alpha.1",
  "type": "module",
  "scripts": {
    "rebuild:alpha": "python3 scripts/build-alpha.py",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "verify:alpha": "npm run rebuild:alpha && node --check public/recovered/v1.0.0-alpha.1-r3.js && node scripts/smoke-alpha.mjs",
    "check": "tsc --noEmit && npm run verify:recovery && npm run verify:alpha",
    "predev": "npm run rebuild:alpha",
    "prebuild": "npm run rebuild:alpha"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
