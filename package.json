{
  "name": "pokeregions",
  "private": true,
  "version": "1.0.0-alpha.1",
  "type": "module",
  "scripts": {
    "rebuild:alpha": "python3 scripts/build-alpha.py",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "verify:alpha": "npm run rebuild:alpha && node scripts/check-alpha-syntax.mjs && node scripts/smoke-alpha.mjs",
    "check": "tsc --noEmit && npm run verify:recovery && npm run verify:alpha && npm run test:overworld",
    "predev": "npm run rebuild:alpha",
    "prebuild": "npm run rebuild:alpha",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "test:overworld": "node scripts/test-overworld.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@supabase/supabase-js": "2.117.1"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "wrangler": "4.102.0"
  },
  "engines": {
    "node": "22.x"
  }
}
